{
  "version": "2.17",
  "fileToken": "mochi-pet-pen-design-v1",
  "themes": {
    "mode": [
      "dark",
      "light"
    ]
  },
  "variables": {
    "bg-base": {
      "type": "color",
      "value": [
        { "value": "#090A0F", "theme": { "mode": "dark" } },
        { "value": "#F0F2F5", "theme": { "mode": "light" } }
      ]
    },
    "bg-card": {
      "type": "color",
      "value": [
        { "value": "#12151F", "theme": { "mode": "dark" } },
        { "value": "#FFFFFF", "theme": { "mode": "light" } }
      ]
    },
    "bg-screen": {
      "type": "color",
      "value": [
        { "value": "#050508", "theme": { "mode": "dark" } },
        { "value": "#050508", "theme": { "mode": "light" } }
      ]
    },
    "oled-cyan": {
      "type": "color",
      "value": [
        { "value": "#00F0FF", "theme": { "mode": "dark" } },
        { "value": "#00C2CF", "theme": { "mode": "light" } }
      ]
    },
    "oled-amber": {
      "type": "color",
      "value": [
        { "value": "#FFB800", "theme": { "mode": "dark" } },
        { "value": "#D99B00", "theme": { "mode": "light" } }
      ]
    },
    "oled-pink": {
      "type": "color",
      "value": [
        { "value": "#FF2A85", "theme": { "mode": "dark" } },
        { "value": "#E01870", "theme": { "mode": "light" } }
      ]
    },
    "text-main": {
      "type": "color",
      "value": [
        { "value": "#FFFFFF", "theme": { "mode": "dark" } },
        { "value": "#111827", "theme": { "mode": "light" } }
      ]
    },
    "text-muted": {
      "type": "color",
      "value": [
        { "value": "#94A3B8", "theme": { "mode": "dark" } },
        { "value": "#64748B", "theme": { "mode": "light" } }
      ]
    },
    "border-subtle": {
      "type": "color",
      "value": [
        { "value": "#1E293B", "theme": { "mode": "dark" } },
        { "value": "#E2E8F0", "theme": { "mode": "light" } }
      ]
    },
    "font-family": {
      "type": "string",
      "value": "Inter"
    }
  },
  "children": [
    {
      "type": "frame",
      "id": "screen_main_companion",
      "name": "Screen 1 — Dasai Mochi Main Companion",
      "x": 0,
      "y": 0,
      "width": 1440,
      "height": 900,
      "fill": "$bg-base",
      "layout": "vertical",
      "padding": [32, 48],
      "gap": 24,
      "children": [
        {
          "type": "frame",
          "id": "header_bar",
          "name": "Navigation & Status Header",
          "width": "fill_container",
          "height": 60,
          "layout": "horizontal",
          "alignItems": "center",
          "justifyContent": "space-between",
          "fill": "$bg-card",
          "cornerRadius": 16,
          "padding": [12, 24],
          "stroke": "$border-subtle",
          "strokeWidth": 1,
          "children": [
            {
              "type": "frame",
              "id": "brand_group",
              "name": "Brand Info",
              "layout": "horizontal",
              "alignItems": "center",
              "gap": 12,
              "children": [
                {
                  "type": "frame",
                  "id": "brand_badge",
                  "name": "Mochi Logo Icon",
                  "width": 36,
                  "height": 36,
                  "fill": "$oled-cyan",
                  "cornerRadius": 10,
                  "alignItems": "center",
                  "justifyContent": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "badge_txt",
                      "name": "Icon Char",
                      "content": "🍡",
                      "fontSize": 18,
                      "fill": "#000000"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "app_title",
                  "name": "App Name",
                  "content": "DASAI MOCHI // OS v3.2",
                  "fontSize": 18,
                  "fontWeight": "bold",
                  "fontFamily": "$font-family",
                  "fill": "$text-main"
                }
              ]
            },
            {
              "type": "frame",
              "id": "telemetry_pill_group",
              "name": "Telemetry Badges",
              "layout": "horizontal",
              "gap": 12,
              "alignItems": "center",
              "children": [
                {
                  "type": "frame",
                  "id": "badge_gyro",
                  "name": "Gyro Indicator",
                  "padding": [6, 14],
                  "cornerRadius": 20,
                  "fill": "#0F2936",
                  "stroke": "$oled-cyan",
                  "strokeWidth": 1,
                  "children": [
                    {
                      "type": "text",
                      "id": "txt_gyro",
                      "name": "Gyro Label",
                      "content": "● GYRO REACTIVE",
                      "fontSize": 11,
                      "fontWeight": "bold",
                      "fill": "$oled-cyan"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "badge_sound",
                  "name": "Sound Indicator",
                  "padding": [6, 14],
                  "cornerRadius": 20,
                  "fill": "#2D1D05",
                  "stroke": "$oled-amber",
                  "strokeWidth": 1,
                  "children": [
                    {
                      "type": "text",
                      "id": "txt_sound",
                      "name": "Sound Label",
                      "content": "♫ CHIMES ON",
                      "fontSize": 11,
                      "fontWeight": "bold",
                      "fill": "$oled-amber"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "badge_battery",
                  "name": "Battery Indicator",
                  "padding": [6, 14],
                  "cornerRadius": 20,
                  "fill": "#1E293B",
                  "children": [
                    {
                      "type": "text",
                      "id": "txt_battery",
                      "name": "Battery Label",
                      "content": "⚡ 92% DOCK",
                      "fontSize": 11,
                      "fontWeight": "bold",
                      "fill": "$text-main"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
